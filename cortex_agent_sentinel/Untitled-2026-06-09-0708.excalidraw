		{
			"id": "rDVrH4UH",
			"type": "text",
			"x": -8207.907661476733,
			"y": -1451.518303869807,
			"width": 1459.925368164062,
			"height": 2437.224999999999,
			"angle": 0,
			"strokeColor": "#1971c2",
			"backgroundColor": "#fab005",
			"fillStyle": "hachure",
			"strokeWidth": 4,
